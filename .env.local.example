# Copy to .env.local (gitignored) and fill in real values.

# Resend API key — https://resend.com/api-keys
# Required for the contact form (/api/contact) to send email.
RESEND_API_KEY=

# Optional sender address. Must be on a domain verified in Resend,
# e.g. "Yakob Dereje <contact@yourdomain.com>". If unset, Resend's shared
# test sender (onboarding@resend.dev) is used, which only delivers to the
# email address that owns the Resend account.
RESEND_FROM_EMAIL=
